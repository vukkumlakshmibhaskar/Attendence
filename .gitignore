# Team-friendly ignore rules.
# Commit source code, lockfiles, docs, migrations, and .env.example files.
# Keep personal credentials, generated output, datasets, logs, and machine-specific files local.

# Local environment and secrets
.env
.env.*
!.env.example
!**/.env.example
*.local
*.secret
secrets/

# Node / Vite frontend
**/node_modules/
frontend/dist/
frontend/.vite/
.vite/
.turbo/
.next/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / FastAPI service
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.coverage
htmlcov/
pip-wheel-metadata/
*.egg-info/
.venv/
venv/
env/
ENV/

# Go backend
*.exe
*.test
*.out
coverage.out
coverage.html
*.prof
go-backend/bin/
go-backend/tmp/

# Runtime output and logs
**/runtime-logs/
logs/
*.log
*.pid

# Build / cache folders
dist/
build/
tmp/
temp/
.cache/
.parcel-cache/
out/

# Docker, database, and local data dumps
docker-compose.override.yml
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
*.sql.gz
postgres-data/
pgdata/

# ML datasets and training artifacts
datasets/
data/
local-data/
archive*/
**/runs/
**/weights/
**/wandb/
**/mlruns/
*.pt
*.pth
*.ckpt
*.engine
*.tflite
*.unsupported.onnx
*.optimized.onnx

# OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# Editor / IDE files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*.swn

# Secrets and certificates
*.pem
*.key
*.crt
*.p12
